#!/usr/bin/env bash
# Open a URL (or local path) in the running Ash browser via CDP
# (PUT http://localhost:9222/json/new?...).
#
# A manual helper only: it is NOT registered as a desktop handler anywhere
# (no .desktop file, no xdg-mime), so xdg-open/gio open will not route here.
# Needs a live session — the CDP port exists only while Ash is running — and
# exits 0 even when the open failed.
set -u

URL="${1:-}"
[ -n "$URL" ] || exit 1

case "$URL" in
  *://*) ;;
  *) URL="file://$URL" ;;
esac

# Percent-encode everything outside the RFC 3986 unreserved set.
encode() {
  local LC_ALL=C s=$1 out="" i c
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
    esac
  done
  printf '%s' "$out"
}

ENCODED=$(encode "$URL")
curl -s -X PUT "http://localhost:9222/json/new?$ENCODED" >/dev/null 2>&1 || true
exit 0
