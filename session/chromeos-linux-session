#!/usr/bin/env bash
# ChromeOS Ash desktop session on stock Linux, directly on DRM/KMS.
#
# Ported from the `chromeosLinuxSession` package in the old flake.nix:
# prepares the profile, brings up sommelier/Xwayland, injects the Terminal UI
# and runs the patched Ash Chrome in a restart loop.
#
# Ash owns the display (--ozone-platform=drm): there is no host X server and
# no host Wayland compositor. The nested stack is Ash's exo server ->
# sommelier -> Xwayland :10 for Linux apps.
#
# Runs entirely from the repository tree — no Nix store paths, no
# /run/current-system, no /run/opengl-driver.
set -u

# Shared ASH_ROOT + die/log/note, prefixed with "[session] ".
ASH_MSG_PREFIX="[session] "
. "$(dirname "${BASH_SOURCE[0]}")/../scripts/common.sh"

BIN="$ASH_ROOT/dist/bin"
CHROME="$ASH_ROOT/dist/chrome/chromeos-ash"
SOMMELIER="$ASH_ROOT/dist/sommelier/bin/sommelier"
PROFILE="${ASH_PROFILE_DIR:-/var/lib/ash-profile}"
TEST_USER="${ASH_LOGIN_PROFILE:-test-user}"

ASH_DRM_CARD="${ASH_DRM_CARD:-/dev/dri/card0}"
LOGIN_USER="${ASH_LOGIN_USER:-linux@local}"

chrome_pid=""        # live Chrome, so a single kill/teardown can reap it
sommelier_bg=""      # the Xwayland/sommelier supervisor subshell
fast_fail=0          # consecutive quick Chrome failures, to break the respawn loop

# Ash owns the DRM device; if it disappears (driver unload, VM teardown) there
# is no point respawning into a dead display.
display_alive() {
  [ -e "$ASH_DRM_CARD" ] && [ -r "$ASH_DRM_CARD" ] && [ -w "$ASH_DRM_CARD" ]
}

# Between restarts: reap the nested compositor (sommelier + its Xwayland :10).
# Never use `pkill -x Xwayland` here: an unrelated host Xwayland (niri,
# another session) must survive.
stop_compositor() {
  [ -n "$sommelier_bg" ] && kill "$sommelier_bg" 2>/dev/null
  sommelier_bg=""
  pkill -x sommelier 2>/dev/null || true
  pkill -f 'Xwayland :10' 2>/dev/null || true
  return 0
}

# Full teardown on EXIT/INT/TERM. Without this, killing the session leaked
# Chrome, sommelier and Xwayland (start-session.sh only pkills dist/bin/), which
# is why a logout used to need a pile of manual kills in the TTY.
cleanup() {
  [ -n "$chrome_pid" ] && kill "$chrome_pid" 2>/dev/null
  stop_compositor
  # Remove the pid file so session-bridge never signals a dead script.
  [ -n "${SESSION_PID_FILE:-}" ] && rm -f "$SESSION_PID_FILE"
  return 0
}

# --- environment -----------------------------------------------------------

ensure_runtime_dir() {
  if [ -d "/run/user/$(id -u)" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
  else
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/xdg-runtime-$(id -u)}"
    mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
    chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
  fi
  export XDG_RUNTIME_DIR
}

# --- profile ---------------------------------------------------------------

prepare_profile() {
  mkdir -p "$PROFILE" || die "cannot create profile dir $PROFILE (run scripts/setup-system.sh once)"
  mkdir -p "$PROFILE/$TEST_USER"
  export CHROMEOS_SESSION_LOG_DIR="$PROFILE/$TEST_USER/log"
  mkdir -p "$CHROMEOS_SESSION_LOG_DIR"

  # Skip OOBE and make Chrome treat this profile as cleanly shut down.
  touch "$PROFILE/First Run"
  touch "$PROFILE/.oobe_completed"
  if [ ! -f "$PROFILE/Local State" ]; then
    printf '%s\n' '{"OOBE":{"oobe_complete":true},"help_app":{"showed_in_oobe":true}}' \
      > "$PROFILE/Local State"
  fi
  rm -f "$PROFILE/$TEST_USER/AccountManagerTokens.bin" \
        "$PROFILE/$TEST_USER/trusted_vault.pb"

  perl -MJSON::PP -0777 -i -pe '
    my $j = eval { decode_json($_) };
    if ($j) {
      delete $j->{sync}{cached_persistent_auth_error};
      delete $j->{sync}{gaia_id};
      delete $j->{sync}{transport_data_per_account};
      $j->{google}{services}{consented_to_sync} = JSON::PP::false if ref $j->{google}{services} eq "HASH";
      $j->{signin}{sync_paused_start_time} = "" if ref $j->{signin} eq "HASH";
      delete $j->{multidevice_setup};
      $j->{crostini}{enabled} = JSON::PP::true;
      $j->{crostini}{linux_packages_enabled} = JSON::PP::true;
      $j->{profile}{exit_type} = "Normal";
      $j->{profile}{exited_cleanly} = JSON::PP::true;
      $j->{sessions}{event_log} = [];
      $_ = encode_json($j);
    }
  ' "$PROFILE/$TEST_USER/Preferences" 2>/dev/null || true

  perl -MJSON::PP -0777 -i -pe '
    my $j = eval { decode_json($_) };
    if ($j) {
      delete $j->{signin}{active_accounts};
      delete $j->{signin}{active_accounts_last_emitted};
      $j->{profile}{info_cache}{$ENV{ASH_LOGIN_PROFILE}}{is_consented_primary_account} = JSON::PP::false
        if ref $j->{profile}{info_cache}{$ENV{ASH_LOGIN_PROFILE}} eq "HASH";
      $_ = encode_json($j);
    }
  ' "$PROFILE/Local State" 2>/dev/null || true
}

# --- main loop -------------------------------------------------------------

for tool in xrdb curl perl awk pgrep pkill; do
  command -v "$tool" >/dev/null 2>&1 ||
    { echo "[session] missing '$tool'" >&2; exit 1; }
done
[ -x "$CHROME" ]   || die "patched chrome missing — run: make chrome"
[ -x "$SOMMELIER" ] || die "sommelier missing — run: make sommelier"
[ -x "$BIN/register-apps" ] || die "bridges missing — run: make bridges"
command -v Xwayland >/dev/null 2>&1 ||
  log "WARNING: Xwayland not in PATH — Linux apps will not render (install xwayland)"

export ASH_LOGIN_PROFILE="$TEST_USER"
prepare_profile
ensure_runtime_dir

# DRM mode has no host X display. Clear any inherited X11 environment so it
# cannot leak into Chrome or the nested sommelier/Xwayland stack; guest apps
# get DISPLAY=:10 explicitly from sommelier/shell-stub/crostini-bridge.
unset DISPLAY XAUTHORITY
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Crash dumps land in <DIR_CONFIG_DIR>/chromium/Crash Reports. Before login
# ChromeOS resolves the home directory to "/", so that becomes
# /.config/chromium/Crash Reports — not creatable by a normal user — and
# crashpad logs "mkdir : No such file or directory", starting up without a
# database. Anchor the config base inside the writable profile instead.
export CHROME_CONFIG_HOME="$PROFILE/.config"
log "runtime=$XDG_RUNTIME_DIR card=$ASH_DRM_CARD profile=$PROFILE"

# Reap Chrome and the nested compositor on any teardown path — a plain `kill`
# of this script must not leak them (that was the "long list of kills in the
# TTY").
trap cleanup EXIT
trap 'log "interrupted"; exit 130' INT
trap 'log "terminated";  exit 143' TERM

# Publish our pid so session-bridge can request a clean shutdown. When the user
# signs out, Ash calls StopSessionWithReason on org.chromium.SessionManager; the
# bridge signals THIS script (SIGTERM) instead of leaving Chrome alive on a black
# screen. cleanup() removes the file on the way out.
SESSION_PID_FILE="$XDG_RUNTIME_DIR/chromeos-linux-session.pid"
printf '%s\n' "$$" >"$SESSION_PID_FILE" || log "WARNING: could not write $SESSION_PID_FILE"

while true; do
  rm -f "$XDG_RUNTIME_DIR/wayland-0" "$XDG_RUNTIME_DIR/wayland-0.lock" \
        "$XDG_RUNTIME_DIR/wayland-1" "$XDG_RUNTIME_DIR/wayland-1.lock" \
        /tmp/.X10-lock /tmp/.X11-unix/X10 2>/dev/null || true

  mkdir -p "$PROFILE/$TEST_USER"
  "$BIN/register-apps" "$PROFILE/$TEST_USER/Preferences" >&2 || true

  # Terminal UI injection (waits for the CDP port, then reloads the page).
  perl "$ASH_ROOT/session/terminal-inject.pl" "$ASH_ROOT/terminal/terminal-ui.js" \
    >/dev/null 2>&1 &

  # Xwayland :10 in front of the Ash-hosted compositor.
  (
    while true; do
      while [ ! -S "$XDG_RUNTIME_DIR/wayland-0" ]; do sleep 0.5; done
      until curl -fsS --max-time 1 http://127.0.0.1:9222/json/version >/dev/null 2>&1; do
        sleep 0.5
      done
      pkill -f 'Xwayland :10' 2>/dev/null || true
      rm -f "$XDG_RUNTIME_DIR/wayland-1" "$XDG_RUNTIME_DIR/wayland-1.lock" \
            /tmp/.X10-lock /tmp/.X11-unix/X10
      (
        for _ in $(seq 1 10); do
          DISPLAY=:10 xrdb -merge /dev/null 2>/dev/null && {
            printf '%s\n' \
              'XTerm*background: black' \
              'XTerm*foreground: white' \
              '*background: black' \
              '*foreground: white' | DISPLAY=:10 xrdb -merge 2>/dev/null || true
            break
          }
          sleep 0.5
        done
      ) &
      # GPU path. --noop-driver leaves drm_fd == -1, so without an explicit
      # device there is no ctx.gbm and every dmabuf gate stays shut: Xwayland
      # is spawned with -shm and clients only ever see wl_shm.
      #   --force-drm-device      opens the render node directly, bypassing
      #                           open_virtgpu (which matches virtio-gpu only);
      #                           sets ctx.gbm/drm — without it neither flag
      #                           below has any effect;
      #   --enable-linux-dmabuf   advertise zwp_linux_dmabuf_v1 to our own
      #                           clients — gated on ctx.gbm, hence the flag
      #                           above; direct-rendering clients (OBS,
      #                           glxgears) then export dmabuf buffers that
      #                           chrome imports directly (zero copy);
      #   --xwayland-gl-driver-path
      #                           LIBGL_DRIVERS_PATH baked in at build time is
      #                           /opt/google/cros-containers/lib, which does
      #                           not exist here, so Xwayland would find no DRI
      #                           drivers without this hint.
      #
      # --glamor: Xwayland renders through glamor (GPU) instead of falling
      # back to -shm, so the X server's own 2D operations (scroll, large-window
      # copies) are accelerated too, not just client-side GL. The X11 branch
      # used to leave this out because glamor made the OBS preview flicker
      # (chrome blends a surface whose alpha byte is 0); it is enabled here on
      # the DRM path. If that flicker or a blank hardware-OBS preview comes
      # back, this flag is the first thing to bisect.
      SOMMELIER_DISPLAY=wayland-0 \
      WAYLAND_DISPLAY=wayland-0 \
      XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        "$SOMMELIER" \
          --noop-driver \
          -X --glamor \
          --socket=wayland-1 \
          --x-display=10 \
          --xwayland-path="$(command -v Xwayland || echo /usr/bin/Xwayland)" \
          --vm-identifier=termina \
          --no-exit-with-child \
          --force-drm-device="${ASH_DRM_DEVICE:-/dev/dri/renderD128}" \
          --enable-linux-dmabuf \
          --xwayland-gl-driver-path=/usr/lib/dri \
          -- sleep infinity \
          2>>"$PROFILE/sommelier.log" || true
      sleep 1
    done
  ) &
  sommelier_bg=$!

  login_flags=()
  if [ "${ASH_DIRECT_LOGIN:-1}" = "1" ]; then
    login_flags+=(--login-user="$LOGIN_USER" --login-profile="$TEST_USER")
  elif [ "${ASH_LOGIN_MANAGER:-0}" = "1" ]; then
    login_flags+=(--login-manager --oobe-skip-to-login)
  fi

  # --use-angle=gles-egl is required on DRM. ANGLE's default Linux backend is
  # OpenGL/GLX; with no DISPLAY on a VT, eglInitialize fails with "Could not
  # open the default X display", the GPU process exits, and Viz aborts with
  # "Software compositing fallback is unavailable". gles-egl makes ANGLE use
  # the native Mesa EGL/GLES path (and GBM), which works on KMS.
  log "starting Ash (ozone=drm card=$ASH_DRM_CARD)"
  chrome_start=$(date +%s)
  # --ash-host-window-bounds is deliberately omitted: without it
  # DisplayManager::InitFromCommandLine() returns false and, because
  # IsRunningAsSystemCompositor() is true, ForceInitialConfigureWithObservers()
  # runs the real DRM/KMS configuration. Passing the switch would create a
  # fake display from the size string instead.
  "$CHROME" \
    --ash-dev-shortcuts \
    --no-sandbox \
    --disable-setuid-sandbox \
    --disable-gpu-sandbox \
    --disable-stack-profiler \
    --disable-mojo-broker \
    --enable-wayland-server \
    --wayland-server-socket=wayland-0 \
    --enable-features=Crostini \
    --disable-features=SamplingProfiler,AccountConsistency,SigninInterception,SampleSystemWebApp,PhoneHub,PhoneHubCameraRoll,PhoneHubNotifications,PhoneHubTaskContinuation,EcheSWA,NearbyShare \
    --disable-sync \
    --disable-gaia-services \
    --disable-signin-scoped-device-id \
    --allow-failed-policy-fetch-for-test \
    --ignore-user-profile-mapping-for-tests \
    --no-first-run \
    --remote-debugging-port=9222 \
    --ignore-gpu-blocklist \
    --enable-logging=stderr \
    --ozone-platform=drm \
    --use-angle=gles-egl \
    --user-data-dir="$PROFILE" \
    "${login_flags[@]}" \
    2>>"$PROFILE/ash.log" &
  chrome_pid=$!
  # wait (not a foreground run) so the INT/TERM traps fire promptly; a plain
  # foreground child would defer the trap until Chrome itself exited.
  wait "$chrome_pid"
  chrome_code=$?
  chrome_pid=""
  uptime=$(( $(date +%s) - chrome_start ))

  stop_compositor

  # --- decide: restart, or end the session cleanly --------------------------
  # A clean exit (code 0) is how Chrome reports a real sign-out. Previously we
  # ignored the code and respawned unconditionally, so logging out just spun up
  # a Chrome with no display to draw on — the black screen that never ended.
  if [ "$chrome_code" -eq 0 ]; then
    log "Chrome exited cleanly (code 0) — treating as sign-out; ending session"
    break
  fi
  # The DRM device we need is gone (driver unload, VM teardown). Respawning
  # here would only spin on "platform failed to initialize".
  if ! display_alive; then
    log "DRM device $ASH_DRM_CARD is gone — cannot restart; ending session"
    break
  fi
  # Guard against a genuine crash-loop: give up after a few quick failures
  # instead of respawning forever. A session that stayed up for a while resets
  # the counter, so a lone late crash still gets a normal restart.
  if [ "$uptime" -lt 30 ]; then
    fast_fail=$((fast_fail + 1))
  else
    fast_fail=0
  fi
  if [ "$fast_fail" -ge 3 ]; then
    log "Chrome died ${fast_fail}x in a row within 30s — giving up; ending session (see $PROFILE/ash.log)"
    break
  fi
  delay=$(( fast_fail * 2 ))
  log "chrome exited (code $chrome_code, uptime ${uptime}s); restarting in ${delay}s"
  sleep "$delay"
done

log "session ended"
exit 0
